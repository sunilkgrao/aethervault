{
  "version": 3,
  "profiles": {
    "ollama-local": {
      "type": "api_key",
      "provider": "ollama",
      "key": "ollama"
    },
    "codex-primary": {
      "type": "cli_auth",
      "provider": "codex",
      "codex_config_dir": "/root/.codex",
      "model": "gpt-5.3-codex-spark",
      "reasoning_effort": "xhigh"
    },
    "codex-secondary": {
      "type": "cli_auth",
      "provider": "codex",
      "codex_config_dir": "/root/codex-alt/.codex",
      "model": "gpt-5.3-codex-spark",
      "reasoning_effort": "xhigh"
    },
    "claude-code-max": {
      "type": "cli_login",
      "provider": "claude-code",
      "model": "claude-opus-4-6"
    },
    "groq-primary": {
      "type": "api_key",
      "provider": "groq",
      "model": "llama-3.3-70b-versatile",
      "key": "ENV:GROQ_API_KEY"
    }
  },
  "pools": {
    "codex": {
      "accounts": ["codex-primary", "codex-secondary"],
      "cooldown_secs": 300
    },
    "claude-code": {
      "accounts": ["claude-code-max"],
      "cooldown_secs": 120
    },
    "groq": {
      "accounts": ["groq-primary"],
      "cooldown_secs": 60
    }
  },
  "order": {
    "ollama": ["ollama-local"]
  }
}
